# Nature Explorer AI Environment Configuration

# Server Port
PORT=3001
NODE_ENV=development

# Open-Weight AI Model Configuration (Hugging Face Inference Providers)
# Get your free token at: https://huggingface.co/settings/tokens
HF_API_TOKEN=
HF_MODEL_NAME=google/vit-base-patch16-224
# Optional custom endpoint (e.g. Hugging Face Dedicated Endpoint or Inference Provider)
HF_INFERENCE_ENDPOINT=

# Local Model Configuration (Optional - Ollama / Local Vision Endpoint)
# When set to true, requests will route to your local vision model (e.g., LLaVA, BakLLaVA)
LOCAL_MODEL_ENABLED=false
LOCAL_MODEL_ENDPOINT=http://localhost:11434/api/generate
LOCAL_MODEL_NAME=llava

# Frontend Vite Proxy Port (Vite runs on 5173 by default)
VITE_API_URL=http://localhost:3001
